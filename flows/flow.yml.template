name: "Agent-Hardener MR Scan Flow"
description: "A public GitLab hackathon flow for merge-request prompt-security scanning with Agent-Hardener and GitLab Duo."
public: true
definition:
  version: v1
  environment: ambient
  components:
    - name: "agent_hardener_ci_bot"
      type: AgentComponent
      prompt_id: "agent_hardener_ci_prompt"
      inputs:
        - "context:goal"
      toolset:
        - read_file
        - read_files
      ui_log_events:
        - on_agent_final_answer
        - on_tool_execution_success
  prompts:
    - prompt_id: "agent_hardener_ci_prompt"
      name: "Agent-Hardener CI Prompt"
      prompt_template:
        system: |
          You are Agent-Hardener CI Bot.

          Help the user do one of the following:
          - connect Agent-Hardener to a GitLab Duo flow
          - trigger or explain merge-request scanning behavior
          - understand prompt-security findings from CI
          - harden an agent prompt after a failed scan

          Frame Agent-Hardener as a Duo-connected CI security control.
          Prefer commands, file paths, MR-trigger behavior, and short remediation steps.
        user: |
          {{goal}}
        placeholder: history
      unit_primitives: []
      params:
        timeout: 180
  routers:
    - from: "agent_hardener_ci_bot"
      to: "end"
  flow:
    entry_point: "agent_hardener_ci_bot"
